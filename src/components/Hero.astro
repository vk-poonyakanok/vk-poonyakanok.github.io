---
import SocialLinks from './SocialLinks.astro';

// Stat numbers that age are computed at load from data-years-since rather
// than hand-edited — update the anchor date, not the visible text.
// Clinical practice anchors to the Nong Khai Hospital start (2019-09-09).
//
// These four are the first numbers a visitor sees, so they are the ones most
// worth remembering, and every tile is plain language — the page has to work
// for a non-technical screener as well as a hiring manager.
//
// Dropped: "4+ Years data analysis". It was self-asserted, unverifiable, and
// restated the tenure claim in the tile beside it.
//
// "02 Publications" is peer-reviewed papers ONLY — the two with DOIs. Do not
// raise it to 03 or 04 by folding in the syphilis surveillance evaluation
// (filed under research_evaluations, not publications, in profile.yaml) or
// the Saraburi manuscript (still a draft in revision with co-authors, not
// submitted). ~/Github/cv/profile/accomplishments-log.md is explicit: don't
// count it until accepted. Scholar and ORCID both show two.
//
// 157/10,457 are the official AIAT S6 figures (confirmed 2026-08).
//
// Every tile links somewhere. They sit in the one part of the page where a
// visitor is most willing to act, so leaving them inert wasted the slot.
// "12" is the archive count, matching the "/ 12" on §03's archive button.
const stats = [
  { since: '2019-09-09', fallback: '6+', label: 'Years clinical practice', href: '#experience' },
  // Label lengths are tuned to the longest of the others ("Years clinical
  // practice", 23 chars). "Selected of 10,457 · Super AI S6" ran 31 and took
  // a third line at 390px and 760px while its neighbours took two.
  { value: '157', label: 'Of 10,457 · Super AI S6', href: '#training' },
  { value: '02', label: 'Publications', href: '#publications' },
  { value: '12', label: 'Projects shipped', accent: true, href: '/project/' },
];
---

<header class="rd-hero" id="top">
  <div class="rd-hero-top">
    <div class="rd-hero-copy">
      {/* Line breaks are block spans, not <br>: with <br> the accessible
          name and the text a crawler extracts came out as
          "ClinicalData,Engineered." with no word boundaries. */}
      {/* Trailing spaces sit *inside* the spans on purpose: Astro collapses
          whitespace between elements, so without them the accessible name
          and the extracted text read "ClinicalData,Engineered.". The spans
          are display:block, so a trailing space costs nothing visually. */}
      <h1 class="rd-hero-title" data-sp="0.05">
        <span class="line">Clinical </span><span class="line">Data, </span><span class="line accent">Engineered.</span>
      </h1>
      <p class="rd-hero-lede" data-sp="0.09">
        Vitchakorn <span class="rd-italic">&ldquo;Blue&rdquo;</span> Poonyakanok, MD — a physician bridging <span class="rd-role-word" id="roleSwap">travel medicine</span> into intelligent health systems.
      </p>

      {/* One primary action, pointing at the evidence rather than at
          contact. Contact is already reachable three ways from the top fold
          (the email below, the floating CTA, §07), and the floating CTA
          already carries the internship one-pager -- nothing was pushing a
          recruiter toward the work itself. */}
      <a href="#projects" class="rd-btn rd-hero-cta">VIEW SELECTED WORK ↓</a>

      {/* Moved up from #about: the profile links and the email address are
          what the page is asking a visitor to act on, so they sit above the
          fold rather than one section down. */}
      <SocialLinks class="rd-hero-socials" />
    </div>

    <div class="rd-hero-portrait" data-sp="0.05">
      <img
        src="/pic/vitchakorn.jpg"
        alt="Portrait of Vitchakorn Poonyakanok"
        width="264"
        height="330"
        fetchpriority="high"
      >
      <div class="rd-hero-tag">MD → MSHCA, CARNEGIE MELLON</div>
    </div>
  </div>

  <div class="rd-stats">
    {stats.map((s) => (
      <a class="rd-stat" href={s.href}>
        <div class:list={['rd-stat-num', s.accent && 'accent']}>
          {s.since
            ? <span data-years-since={s.since}>{s.fallback}</span>
            : s.value}
        </div>
        <div class="rd-stat-label">{s.label}</div>
      </a>
    ))}
  </div>
</header>

<script>
  // ── Stat years ──
  document.querySelectorAll<HTMLElement>('[data-years-since]').forEach((el) => {
    const since = el.getAttribute('data-years-since');
    if (!since) return;
    const years = Math.floor(
      (Date.now() - new Date(since).getTime()) / (365.2425 * 864e5)
    );
    el.textContent = years + '+';
  });

  // ── Role word rotation ──
  // The four roles the 3D stage below walks through, cycled in the lede so
  // the hero states the whole span before the visitor scrolls into it.
  const roleEl = document.getElementById('roleSwap');
  const ROLES = ['travel medicine', 'public health', 'data analysis', 'AI engineering'];
  if (roleEl && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let i = 0;
    roleEl.style.transition = 'opacity 0.3s ease';
    setInterval(() => {
      if (document.hidden) return;
      i = (i + 1) % ROLES.length;
      roleEl.style.opacity = '0';
      setTimeout(() => {
        roleEl.textContent = ROLES[i];
        roleEl.style.opacity = '1';
      }, 300);
    }, 2800);
  }
</script>
