---
// Fixed right-edge scrollspy. Hidden below 1100px (see redesign.css) where
// it would collide with the content column.
// 01–07 mirror the numbers printed in each section head. The two items that
// aren't numbered sections get markers instead: the hero is 00, and the 3D
// stage is labelled by what it is rather than given a number of its own.
const items = [
  { id: 'top', num: '00', label: 'Top' },
  { id: 'rolesWrap', num: '3D', label: 'Roles' },
  { id: 'about', num: '01', label: 'About' },
  { id: 'experience', num: '02', label: 'Experience' },
  { id: 'projects', num: '03', label: 'Projects' },
  { id: 'publications', num: '04', label: 'Research & Awards' },
  { id: 'training', num: '05', label: 'Training' },
  { id: 'skills', num: '06', label: 'Capabilities' },
  { id: 'contact', num: '07', label: 'Contact' },
];
---

<nav class="rd-rail" id="rail" aria-label="Section navigation">
  {items.map((i) => (
    <a href={`#${i.id}`} data-rail={i.id}>
      <span class="rd-rail-label">{i.label}</span>
      <span class="rd-rail-num">{i.num}</span>
    </a>
  ))}
</nav>

<script>
  const SECTIONS = ['top', 'rolesWrap', 'about', 'experience', 'projects', 'publications', 'training', 'skills', 'contact'];
  const railLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-rail]'));
  const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-navsec]'));

  function syncActive() {
    // "Active" = the last section whose top has crossed 40% of the viewport,
    // which tracks what the reader is actually looking at better than
    // intersection ratios do for sections of wildly different heights.
    const line = window.innerHeight * 0.4;
    let active = '';
    for (const id of SECTIONS) {
      const el = document.getElementById(id);
      if (el && el.getBoundingClientRect().top <= line) active = id;
    }
    railLinks.forEach((a) => a.classList.toggle('is-active', a.dataset.rail === active));
    navLinks.forEach((a) => a.classList.toggle('is-active', a.dataset.navsec === active));
  }

  // Roles3D removes its whole section when WebGL2 is unavailable or the
  // visitor prefers reduced motion, which would leave rail item 00 pointing
  // at nothing. Deferred to the next frame because this component renders
  // above Roles3D, so its module script runs first — checking synchronously
  // here would always see the section still present.
  requestAnimationFrame(() => {
    for (const a of railLinks) {
      if (!document.getElementById(a.dataset.rail || '')) a.remove();
    }
    syncActive();
  });

  let ticking = false;
  const schedule = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      ticking = false;
      syncActive();
    });
  };
  window.addEventListener('scroll', schedule, { passive: true });
  window.addEventListener('resize', schedule, { passive: true });
  syncActive();
</script>
