---
// One-screen three.js stage showing all four roles at once, each in its own
// corner (travel medicine → public health → data analysis → AI engineering).
//
// This used to be a 640vh scroll runway that walked the camera through the
// roles one at a time; a visitor skimming a portfolio does not have six
// screens of scrolling to spend before reaching a single credential. The
// scene already computed a four-corner arrangement as its closing keyframe,
// so the embedded view now parks there and the runway is gone. The scene
// keeps itself alive with idle animation and mouse parallax instead of
// scroll. public/roles3d/ still walks the sequence when opened directly.
//
// The scene lives at public/roles3d/ so it can own its importmap and module
// script without fighting Astro's bundler.
---

<section class="rd-roles" id="rolesWrap" aria-label="Four roles">
  <div class="rd-roles-pin">
    {/* index.html is spelled out rather than relying on the directory to
        resolve: `astro dev` serves public/ files at their exact path and does
        not fall back to index.html for a directory, so `/roles3d/?embed=1`
        renders the site's own 404 page inside this frame during local
        development. The built site resolves either form. */}
    <iframe
      id="roles3d"
      src="/roles3d/index.html?embed=1"
      title="Four roles — travel medicine, public health, data analysis, AI engineering"
      loading="lazy"
    ></iframe>
  </div>
</section>

<script>
  const wrap = document.getElementById('rolesWrap');
  const frame = document.getElementById('roles3d') as HTMLIFrameElement | null;

  function currentTheme() {
    return document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
  }

  function post(msg: Record<string, unknown>) {
    frame?.contentWindow?.postMessage(msg, window.location.origin);
  }

  if (wrap && frame) {
    // A tall runway with no WebGL behind it is just dead scroll, so collapse
    // it when the scene can't render — same for reduced-motion visitors.
    const canRender =
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
      (() => {
        try {
          return !!document.createElement('canvas').getContext('webgl2');
        } catch {
          return false;
        }
      })();

    if (!canRender) {
      wrap.remove();
    } else {
      frame.addEventListener('load', () => post({ theme: currentTheme() }));

      // The stage measures its own composition and posts back how tall it
      // actually is; redesign.css clamps that to the space available. Without
      // it the section is a full screen tall whatever is in it, and the
      // landscape layout — where the models are only as tall as a lane is
      // wide — sat in the middle of a band of empty background. A 0 means the
      // stage is in its portrait layout and wants the whole screen back.
      window.addEventListener('message', (e) => {
        if (e.origin !== window.location.origin || e.source !== frame.contentWindow) return;
        const h = (e.data as { rolesHeight?: number } | null)?.rolesHeight;
        if (typeof h !== 'number') return;
        if (h > 0) wrap.style.setProperty('--roles-h', Math.round(h) + 'px');
        else wrap.style.removeProperty('--roles-h');
        schedule();
      });

      // The floating CTA is pinned bottom-right, which is exactly where the
      // stage puts its fourth role label. Rather than lay the composition out
      // around it, hide it for the one screen the stage owns.
      const cta = document.getElementById('floatCta');

      let paused: boolean | null = null;
      let behind: boolean | null = null;

      function onScroll() {
        const rect = wrap!.getBoundingClientRect();

        // Stop the scene rendering once the stage has scrolled out of the
        // viewport — it stays in the DOM for the rest of the page. This is
        // the only thing scroll still drives here; the composition itself is
        // fixed, so there is no progress to report.
        const offscreen = rect.bottom <= 0 || rect.top >= window.innerHeight;
        if (offscreen !== paused) {
          paused = offscreen;
          post({ paused: offscreen });
        }

        // Most of the stage, not "visible at all" — otherwise the card blinks
        // out while the stage is still only a sliver at the edge. Measured
        // against the stage's own height rather than the viewport's, because
        // the stage is now often shorter than a screen and would never have
        // reached a fraction of the viewport at all.
        const shown = Math.min(rect.bottom, window.innerHeight) - Math.max(rect.top, 0);
        const covering = shown / Math.min(rect.height, window.innerHeight) > 0.6;
        if (covering !== behind) {
          behind = covering;
          cta?.classList.toggle('is-behind', covering);
        }
      }

      let ticking = false;
      const schedule = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          onScroll();
        });
      };
      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule, { passive: true });
      onScroll();

      // The toggle lives in the nav and only writes the attribute, so mirror
      // the change into the scene rather than wiring the two together.
      new MutationObserver(() => post({ theme: currentTheme() })).observe(
        document.documentElement,
        { attributes: true, attributeFilter: ['data-theme'] }
      );
    }
  }
</script>
