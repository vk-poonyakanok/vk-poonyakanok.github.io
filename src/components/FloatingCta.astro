---
// Standing ask, pinned bottom-right. Dismissible, and the dismissal sticks
// for the session so it doesn't nag a returning reader mid-page.
---

<div class="rd-float-cta" id="floatCta">
  <button type="button" class="rd-float-cta-close" id="floatCtaClose" aria-label="Dismiss">✕</button>
  <a href="/host-org-one-pager.pdf" target="_blank" rel="noopener noreferrer">
    <span class="cta-kicker">OPEN TO OFFERS · USA, ANY STATE</span>
    <span class="cta-title">Summer 2027 Internship — Health Care Analytics</span>
    <span class="cta-meta">May 11 – Aug 20 · 300+ hrs → Host quick-reference (PDF) ↗</span>
  </a>
</div>

<script>
  const cta = document.getElementById('floatCta');
  const close = document.getElementById('floatCtaClose');
  if (cta && sessionStorage.getItem('vp-cta-dismissed') === '1') {
    cta.classList.add('is-dismissed');
  }
  close?.addEventListener('click', () => {
    cta?.classList.add('is-dismissed');
    sessionStorage.setItem('vp-cta-dismissed', '1');
  });
</script>
